// Merge these match blocks into the EXISTING deployed Firestore rules.
// Do not replace the whole ruleset: CampusKit uses other collections too.
// Public students can read the published playlist. Only the verified admin can write.
function isCampusKitMusicAdmin() {
  return request.auth != null
    && request.auth.token.email == "senadesh159@gmail.com"
    && request.auth.token.email_verified == true;
}
match /publicMusic/{trackId} {
  allow read: if resource.data.status == "published";
  allow create: if isCampusKitMusicAdmin()
    && request.resource.data.source == "google-drive"
    && request.resource.data.status == "published"
    && request.resource.data.uploadedBy == "senadesh159@gmail.com"
    && request.resource.data.downloadUrl is string
    && request.resource.data.driveFileId is string
    && request.resource.data.title is string
    && request.resource.data.title.size() > 0
    && request.resource.data.title.size() <= 120;
  allow update: if isCampusKitMusicAdmin()
    && request.resource.data.source == "google-drive"
    && request.resource.data.status == "published";
  allow delete: if isCampusKitMusicAdmin();
}
